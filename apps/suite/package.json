{
  "name": "@jadarat/suite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jadarat Suite shell — the only deployable web app (Next.js App Router, standalone output).",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/suite/server.js",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@jadarat/platform-core": "workspace:*",
    "@jadarat/platform-db": "workspace:*",
    "@jadarat/platform-files": "workspace:*",
    "@jadarat/platform-i18n": "workspace:*",
    "@jadarat/platform-identity": "workspace:*",
    "@jadarat/platform-import": "workspace:*",
    "@jadarat/platform-notifications": "workspace:*",
    "@jadarat/platform-observability": "workspace:*",
    "@jadarat/platform-rbac": "workspace:*",
    "@jadarat/tms": "workspace:*",
    "@jadarat/ui": "workspace:*",
    "@sentry/browser": "11.8.0",
    "@sentry/nextjs": "11.8.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@jadarat/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
