# Jadarat TMS — environment variable NAMES only. Never commit values.
# Copy to apps/suite/.env.local for local development. The app builds and runs without any of these
# (it shows a "not configured" state); set them to connect a Supabase project.

# --- Supabase (server-side Auth; browser Realtime only, ADR 0003 §4.4) — public values ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only: PostgreSQL via the pooler (transaction mode). Never a superuser. (ADR 0002 §5, §7) ---
# Request path, used only by withUserTx(): login role app_server (NOINHERIT, NOBYPASSRLS).
DATABASE_URL_APP_SERVER=
# Background jobs, used only by withSystemTx() (**/jobs/**): login role app_worker.
DATABASE_URL_APP_WORKER=
# Job queue (worker process only, apps/worker; ADR 0005): login role app_queue. Session connection.
DATABASE_URL_APP_QUEUE=
# E-mail (worker process only; ADR 0008, docs/engineering/email.md). EMAIL_PROVIDER (required by the
# worker): resend | smtp | none (switched off: queued messages are recorded as suppressed).
EMAIL_PROVIDER=none
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
# smtp://user:password@relay:587 (STARTTLS) or smtps://…:465; plain SMTP only to localhost (Mailpit).
SMTP_URL=
SMTP_CA_CERT_FILE=
# worker `test-email` mode only: where the sample message goes.
EMAIL_TEST_TO=
# Public origin of the web app for links in e-mails (invitation and password-reset links), e.g.
# https://tms.example.com — https, plain http only for localhost; no path. Required by the worker when
# EMAIL_PROVIDER is not `none`.
APP_BASE_URL=
# Web app (server only): who sends the password-reset e-mail and the "password changed" notice
# (T-M2-17, docs/engineering/password-reset.md): `auth` (default — Supabase Auth's own mailer) or `worker`
# (our notification service; needs a worker that runs continuously and SUPABASE_URL + SUPABASE_SECRET_KEY
# in the WORKER's environment). Any other value stops the app at start-up.
PASSWORD_RESET_DELIVERY=
# PEM root CA of the database server (Supabase: Database Settings → SSL Configuration). Required for any
# non-local database host: the app connects with verify-full TLS only.
DATABASE_CA_CERT=

# --- Server-only, jobs/admin code ONLY (@jadarat/platform-db/admin). Never available to request paths. ---
DATABASE_URL_ADMIN=
# WORKER ONLY (apps/worker): the Auth admin API for password-reset links (T-M2-17) — the project's API
# origin and its secret key (`sb_secret_…`; self-hosted: the service_role token from gen-secrets.sh).
# Never set for the web app (apps/suite): it holds no Auth secret key — invitees sign up through the
# public Auth API, gated by the before-user-created hook, and reset requests are queued for the worker
# (ADR 0002 §7 notes T-M2-07, T-M2-17).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Files (T-M2-18, ADR 0006; docs/engineering/files.md) ---
# The web app holds NO Storage or Auth secret key: it asks Storage for signed URLs with the user's own
# session. The worker's Storage access (scan, quarantine, retention) uses SUPABASE_URL + SUPABASE_SECRET_KEY
# above — worker only, no separate Storage key.
# Web app (server only), self-hosted only — unset on hosted Supabase (the project URL serves both):
# browser-facing Storage origin of signed upload/download URLs, e.g. https://files.example.org (https).
STORAGE_PUBLIC_URL=
# Web app (server only), self-hosted only: where the server asks Storage for signed URLs — the gateway's
# internal port, reachable from the app's network only, e.g. https://gateway:8445.
STORAGE_INTERNAL_URL=
# WORKER ONLY: the malware scanner (clamd) host on the internal network; unset = uploads stay unscanned
# (never clean, never usable).
CLAMD_HOST=
# WORKER ONLY: clamd's port; unset = 3310.
CLAMD_PORT=
# WORKER ONLY: signatures older than this many days (or undated) and nothing is scanned; unset = 7
# (1–7; more only with the test-only override below).
FILE_SCAN_SIGNATURES_MAX_AGE_DAYS=
# WORKER ONLY, TEST INSTALLATIONS ONLY: 1 allows a limit above 7 days (pinned signatures, smoke test);
# refused when JADARAT_ENVIRONMENT looks like production. Never set in a real installation.
FILE_SCAN_SIGNATURES_TEST_OVERRIDE=
# WORKER ONLY: orphan-object sweep, on | off (unset = on); off while a restore is reconciled (files.md §4).
FILE_ORPHAN_SWEEP=
# WORKER ONLY: sweep brake — above this many orphans nothing is removed and an error is logged; unset = 500.
FILE_ORPHAN_SWEEP_MAX=
# WORKER ONLY: sweep brake — above this share (percent) of all objects nothing is removed; unset = 10.
FILE_ORPHAN_SWEEP_MAX_SHARE=
# Not a process variable: FILE_SCANNING=on is a GitHub variable of the `production-jobs` environment that
# makes .github/workflows/jobs.yml start clamd for each hosted pass (files.md §7).
# FILE_SCANNING=
# Self-hosted Storage's own secrets (STORAGE_DB_PASSWORD, STORAGE_DB_PASSWORD_SCRAM, STORAGE_JWT_SECRET,
# STORAGE_JWT_JWKS) are generated by infra/docker/gen-secrets.sh into infra/docker/.secrets/.env and reach
# the storage container (and the db's verifier) only — never the app or the worker.

# --- Bulk user import (T-M2-12, FR-IAM-04; docs/engineering/user-import.md §4) — WORKER ONLY ---
# The import task runs where the worker has Storage (SUPABASE_URL + SUPABASE_SECRET_KEY above). The web
# app needs nothing new (self-hosted: its CSP allows STORAGE_PUBLIC_URL's origin for the browser's upload).
# Same values on every worker of an installation; checked at start-up.
# Pace of import invitations for the whole installation, in milliseconds; unset = 1000 (500–60000: the
# e-mail provider allows 2 requests a second for the whole account).
USER_IMPORT_INVITATION_INTERVAL_MS=
# Import invitations per organization and UTC day; unset = 5000 (1–100000). Above it they wait a day.
USER_IMPORT_DAILY_INVITATIONS=
# The same for an organization on trial; unset = 200 (never above the number above).
USER_IMPORT_TRIAL_DAILY_INVITATIONS=

# --- Tenant resolution (request proxy) ---
# Base domain for tenant subdomains, e.g. jadarat.example -> <tenant-slug>.jadarat.example
JADARAT_BASE_DOMAIN=

# --- Sign-in protection (T-M2-11, FR-IAM-13; docs/engineering/sign-in-protection.md §7–§9) — web app ---
# The limits themselves (lockout, per-client budgets, remembered browsers, lockout e-mail caps) are code
# (packages/platform-identity/src/auth-limits-config.ts) and each organization's security settings — no
# variable. The self-hosted front proxy (infra/docker/front) has no variable either: it sets X-Real-IP.
# The client-IP header your proxy OVERWRITES with the visitor's address, e.g. x-real-ip (X-Forwarded-For is
# refused); `none` = one shared budget for every visitor (an ERROR at every start). Not needed on Vercel.
JADARAT_CLIENT_IP_HEADER=
# Names the deployment (any label, e.g. self-hosted); also in logs and error reports. When set on a
# production server outside Vercel, the app refuses to start without JADARAT_CLIENT_IP_HEADER.
JADARAT_ENVIRONMENT=
# SELF-HOSTED ONLY: the header in which the app sends the visitor key with its Auth calls, for Auth's own
# per-IP limits behind the installation's gateway (e.g. X-Jadarat-Client). NEVER set it on Vercel or with
# hosted Supabase (the app refuses it when VERCEL=1): it would send visitors' addresses to hosted Auth.
JADARAT_AUTH_CLIENT_HEADER=
# SMOKE TEST ONLY (infra/docker/compose.smoke.yaml): every limit window lasts this many seconds (1–3600).
# Refused in production unless AUTH_RATE_LIMIT_WINDOW_SMOKE_ONLY=1, and on Vercel production always.
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_WINDOW_SMOKE_ONLY=

# --- Tests only (set by scripts/db-test.sh or CI; never in deployments) ---
TEST_DATABASE_URL=
TEST_APP_SERVER_URL=
TEST_APP_WORKER_URL=
TEST_APP_QUEUE_URL=
