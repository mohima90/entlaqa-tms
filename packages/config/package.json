{
  "name": "@jadarat/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tooling configuration: tsconfig, ESLint, Prettier, Tailwind preset, Vitest, dependency-cruiser rules (ADR 0001).",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tailwind/preset.css": "./tailwind/preset.css",
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    },
    "./vitest/empty-module": "./vitest/empty-module.js",
    "./dependency-cruiser": "./dependency-cruiser/rules.cjs"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "vitest": "^5.0.0"
  }
}
