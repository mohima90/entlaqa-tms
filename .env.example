# Jadarat TMS — environment variable NAMES only. Never commit values.
# Copy to apps/suite/.env.local for local development. The app builds and runs without any of these
# (it shows a "not configured" state); set them to connect a Supabase project.

# --- Supabase (server-side Auth; browser Realtime only, ADR 0003 §4.4) — public values ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only: PostgreSQL via the pooler (transaction mode). Never a superuser. (ADR 0002 §5, §7) ---
# Request path, used only by withUserTx(): login role app_server (NOINHERIT, NOBYPASSRLS).
DATABASE_URL_APP_SERVER=
# Background jobs, used only by withSystemTx() (**/jobs/**): login role app_worker.
DATABASE_URL_APP_WORKER=
# Job queue (worker process only, apps/worker; ADR 0005): login role app_queue. Session connection.
DATABASE_URL_APP_QUEUE=
# E-mail (worker process only; ADR 0008, docs/engineering/email.md). EMAIL_PROVIDER (required by the
# worker): resend | smtp | none (switched off: queued messages are recorded as suppressed).
EMAIL_PROVIDER=none
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
# smtp://user:password@relay:587 (STARTTLS) or smtps://…:465; plain SMTP only to localhost (Mailpit).
SMTP_URL=
SMTP_CA_CERT_FILE=
# worker `test-email` mode only: where the sample message goes.
EMAIL_TEST_TO=
# Public origin of the web app for links in e-mails (invitation accept links), e.g.
# https://tms.example.com — https, plain http only for localhost; no path. Required by the worker when
# EMAIL_PROVIDER is not `none`.
APP_BASE_URL=
# PEM root CA of the database server (Supabase: Database Settings → SSL Configuration). Required for any
# non-local database host: the app connects with verify-full TLS only.
DATABASE_CA_CERT=

# --- Server-only, jobs/admin code ONLY (@jadarat/platform-db/admin). Never available to request paths. ---
DATABASE_URL_ADMIN=
# Never set for the web app (apps/suite): it holds no Auth secret key — invitees sign up through the public
# Auth API, gated by the before-user-created hook (ADR 0002 §7 note T-M2-07).
SUPABASE_SECRET_KEY=

# --- Tenant resolution (request proxy) ---
# Base domain for tenant subdomains, e.g. jadarat.example -> <tenant-slug>.jadarat.example
JADARAT_BASE_DOMAIN=

# --- Tests only (set by scripts/db-test.sh or CI; never in deployments) ---
TEST_DATABASE_URL=
TEST_APP_SERVER_URL=
TEST_APP_WORKER_URL=
TEST_APP_QUEUE_URL=
