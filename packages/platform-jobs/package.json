  "devDependencies": {
    "@jadarat/config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
