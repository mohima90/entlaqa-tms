{
  "name": "@jadarat/platform-i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "i18n: locales (English default for now + Arabic), direction, next-intl routing, messages (ADR 0007).",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./dates": "./src/dates.ts",
    "./hijri": "./src/hijri.ts",
    "./regional-presets": "./src/regional-presets.ts",
    "./text": "./src/text.ts",
    "./routing": "./src/routing.ts",
    "./messages/ar.json": "./messages/ar.json",
    "./messages/en.json": "./messages/en.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next-intl": "4.14.9"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@jadarat/config": "workspace:*",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
