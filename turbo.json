{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalDependencies": [".env.example", "packages/config/tsconfig/*.json"],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "PW_CHROMIUM_EXECUTABLE", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!e2e/**",
        "../../docs/design/tokens/tokens.css",
        "../../docs/design/tokens/themes/*.css"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "JADARAT_BASE_DOMAIN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "TEST_APP_SERVER_URL",
        "TEST_APP_WORKER_URL",
        "TEST_APP_QUEUE_URL",
        "JADARAT_REQUIRE_INTEGRATION"
      ]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
