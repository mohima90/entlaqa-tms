{
  "name": "@jadarat/platform-jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Background jobs and domain-event delivery (ADR 0004, ADR 0005): graphile-worker runner, outbox dispatcher, subscriber registry under ./jobs (importable only from job code and apps/worker); the web app's request for a worker pass under ./kick and ./kick/next (GitHub workflow_dispatch, no queue access).",
  "sideEffects": false,
  "exports": {
    "./jobs": "./src/jobs/index.ts",
    "./kick": "./src/kick/dispatch.ts",
    "./kick/next": "./src/kick/next.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@jadarat/platform-db": "workspace:*",
    "@jadarat/platform-observability": "workspace:*",
    "graphile-worker": "0.18.0",
    "pg": "8.23.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "devDependencies": {
    "@jadarat/config": "workspace:*",
    "@jadarat/platform-core": "workspace:*",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
