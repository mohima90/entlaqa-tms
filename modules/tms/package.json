{
  "name": "@jadarat/tms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jadarat TMS module: domain services, server actions, permissions (schema `tms`). Planning cycles (EP-PLN).",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./actions/sessions": "./src/actions/sessions.ts",
    "./actions/planning": "./src/actions/planning.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@jadarat/platform-core": "workspace:*",
    "@jadarat/platform-db": "workspace:*",
    "@jadarat/platform-rbac": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jadarat/config": "workspace:*",
    "@jadarat/platform-identity": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
